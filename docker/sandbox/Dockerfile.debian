FROM debian:12

WORKDIR /root

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Update system and install essential packages
RUN apt update && apt install -y \
    curl wget gnupg lsb-release ca-certificates patch \
    build-essential file procps net-tools gawk tar \
    python3 python3-pip python3-venv python3-dev \
    nodejs npm \
    libffi-dev sqlite3 supervisor \
    imagemagick sox libboost-all-dev \
    cmake git \
    libssl-dev zlib1g-dev libbz2-dev libreadline-dev \
    libsqlite3-dev llvm libncursesw5-dev xz-utils tk-dev \
    libxml2-dev libxmlsec1-dev liblzma-dev \
    make \
    && apt clean && rm -rf /var/lib/apt/lists/*

# Create sandbox user
RUN groupadd -r sandbox && useradd -r -g sandbox sandbox
RUN apt install -y passwd && \
    useradd -m -s /bin/bash sandbox && \
    echo "sandbox:sandbox" | passwd --stdin sandbox && \
    usermod -aG sudo sandbox

# Create workspace directory
RUN mkdir -p /workspace /training_data && \
    chown -R sandbox:sandbox /workspace /training_data

# Install pyenv
RUN curl https://pyenv.run | bash

ENV HOME /root
# Set up environment variables for pyenv
ENV PYENV_ROOT="/root/.pyenv"
ENV PATH="$PYENV_ROOT/shims:$PYENV_ROOT/bin:$PATH"

RUN /bin/bash -c "eval \"$(pyenv init --path)\" && \
    pyenv install 3.10.0 && \
    pyenv global 3.10.0 && \
    pyenv rehash && \
    python --version"

# Install Python packages for AI operations
RUN python3 -m pip install --upgrade pip && \
    python3 -m pip install \
    requests aiohttp websockets \
    psutil docker \
    opencv-python-headless \
    numpy pandas scipy \
    scikit-learn \
    pillow \
    pytesseract \
    SpeechRecognition \
    pyttsx3 \
    beautifulsoup4 \
    selenium \
    playwright

# Install Node.js packages for web automation
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_SKIP_DOWNLOAD=true
RUN npm install -g --unsafe-perm \
    puppeteer \
    cheerio \
    axios \
    ws

# Set up supervisor for process management
RUN mkdir -p /etc/supervisor/conf.d /var/log/supervisor && \
    chown -R sandbox:sandbox /var/log/supervisor
COPY docker/sandbox/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Copy training scripts
COPY docker/training/train_linux_operations.py /usr/local/bin/
RUN chmod +x /usr/local/bin/train_linux_operations.py

# Set working directory
WORKDIR /workspace

# Switch to sandbox user
USER sandbox

# Environment variables
ENV HOME=/home/sandbox
ENV PATH="/home/sandbox/.local/bin:${PATH}"
ENV SANDBOX_TYPE=debian

# Default command
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]