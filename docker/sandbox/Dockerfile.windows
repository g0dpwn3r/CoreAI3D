# Wine-based Windows compatibility sandbox using Linux base
# This provides Windows executable support through Wine, similar to WinApps
FROM ubuntu:22.04

WORKDIR /root

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive
ENV WINEDEBUG=-all

# Install Wine and essential dependencies
RUN apt-get update && apt-get install -y \
    wget \
    gnupg2 \
    software-properties-common \
    ca-certificates \
    && dpkg --add-architecture i386 \
    && wget -nc https://dl.winehq.org/wine-builds/winehq.key \
    && apt-key add winehq.key \
    && add-apt-repository 'deb https://dl.winehq.org/wine-builds/ubuntu/ jammy main' \
    && apt-get update \
    && apt-get install -y --install-recommends winehq-stable \
    winbind \
    xvfb \
    cabextract \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install essential Linux tools (these run natively)
RUN apt-get update && apt-get install -y \
    git \
    curl \
    vim \
    nano \
    htop \
    procps \
    net-tools \
    iproute2 \
    iputils-ping \
    traceroute \
    file \
    tree \
    findutils \
    grep \
    sed \
    gawk \
    tar \
    gzip \
    bzip2 \
    unzip \
    python3 \
    python3-pip \
    python3-venv \
    nodejs \
    npm \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Initialize Wine prefix (creates the .wine directory structure)
RUN wineboot --init

# Install winetricks for additional Windows components
RUN wget -O /usr/local/bin/winetricks https://raw.githubusercontent.com/Winetricks/winetricks/master/src/winetricks \
    && chmod +x /usr/local/bin/winetricks

# Create sandbox user
RUN useradd -m -s /bin/bash sandbox && \
    echo "sandbox:sandbox" | chpasswd && \
    usermod -aG sudo sandbox

# Create workspace directories (mimicking Windows paths)
RUN mkdir -p /workspace /training_data /windows_workspace/c \
    && chown -R sandbox:sandbox /workspace /training_data /windows_workspace

# Install Python packages for AI operations (Linux native Python)
RUN pip3 install --upgrade pip && \
    pip3 install \
    requests aiohttp websockets \
    psutil docker \
    opencv-python-headless \
    numpy pandas scipy \
    scikit-learn \
    pillow \
    pytesseract \
    SpeechRecognition \
    pyttsx3 \
    beautifulsoup4 \
    selenium

# Install Node.js packages for web automation
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_SKIP_DOWNLOAD=true
RUN npm install -g --unsafe-perm \
    puppeteer \
    cheerio \
    axios \
    ws

# Copy training scripts
COPY docker/training/train_windows_operations.py /usr/local/bin/
RUN chmod +x /usr/local/bin/train_windows_operations.py

# Set working directory
WORKDIR /workspace

# Switch to sandbox user
USER sandbox

# Environment variables
ENV HOME=/home/sandbox
ENV PATH="/home/sandbox/.local/bin:${PATH}"
ENV SANDBOX_TYPE=windows
ENV WINEPREFIX="/home/sandbox/.wine"
ENV DISPLAY=:99

# Default command - start a bash shell in the sandbox
CMD ["/bin/bash", "-c", "echo 'CoreAI3D Windows Compatibility Sandbox Ready (Wine-based)'; exec /bin/bash"]
