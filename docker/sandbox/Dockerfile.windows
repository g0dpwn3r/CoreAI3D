# Wine-based Windows compatibility sandbox using Linux base
# This provides Windows executable support through Wine, similar to WinApps
FROM ubuntu:22.04

WORKDIR /root

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive
ENV WINEDEBUG=-all

# Install Wine and essential dependencies
RUN apt-get update && apt-get install -y \
    wget \
    gnupg2 \
    software-properties-common \
    ca-certificates \
    ubuntu-keyring \
    && dpkg --add-architecture i386 \
    && wget -nc https://dl.winehq.org/wine-builds/winehq.key \
    && gpg --dearmor -o /usr/share/keyrings/winehq-archive-keyring.gpg winehq.key \
    && echo "deb [signed-by=/usr/share/keyrings/winehq-archive-keyring.gpg] https://dl.winehq.org/wine-builds/ubuntu/ jammy main" > /etc/apt/sources.list.d/winehq.list \
    && rm -f winehq.key \
    && apt-get update \
    && apt-get install -y --install-recommends winehq-stable \
    winbind \
    xvfb \
    cabextract \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install essential Linux tools (these run natively)
RUN apt-get update && apt-get install -y \
    git \
    curl \
    vim \
    nano \
    htop \
    procps \
    net-tools \
    iproute2 \
    iputils-ping \
    traceroute \
    file \
    tree \
    findutils \
    grep \
    sed \
    gawk \
    tar \
    gzip \
    bzip2 \
    unzip \
    python3 \
    python3-pip \
    python3-venv \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 20.x from NodeSource (modern version required for puppeteer)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Verify Node.js installation
RUN node --version && npm --version

# Install Python packages for AI operations
RUN python3 -m pip install --upgrade pip && \
    pip3 install \
        requests aiohttp websockets \
        psutil docker \
        opencv-python-headless \
        numpy pandas scipy \
        scikit-learn \
        pillow \
        pytesseract \
        SpeechRecognition \
        pyttsx3 \
        beautifulsoup4 \
        selenium \
        playwright

# Install Node.js packages for web automation
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_SKIP_DOWNLOAD=true
RUN npm install -g \
    cheerio \
    axios \
    ws

# Create sandbox user
RUN useradd -m -s /bin/bash sandbox

# Create workspace directory
RUN mkdir -p /workspace /training_data && \
    chown -R sandbox:sandbox /workspace /training_data

# Switch to sandbox user
USER sandbox

# Environment variables
ENV HOME=/home/sandbox
ENV PATH="/home/sandbox/.local/bin:${PATH}"
ENV SANDBOX_TYPE=windows
ENV WINEPREFIX="/home/sandbox/.wine"
ENV DISPLAY=:99

# Set working directory
WORKDIR /workspace

# Default command - start a bash shell in the sandbox
CMD ["/bin/bash", "-c", "echo 'CoreAI3D Windows Compatibility Sandbox Ready (Wine-based)'; exec /bin/bash"]
