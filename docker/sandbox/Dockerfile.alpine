FROM alpine:3.20

# Update & install base dependencies
RUN apk update && apk upgrade && apk add --no-cache \
    python3 py3-pip nodejs npm \
    curl ca-certificates bash sudo supervisor \
    build-base git openssl-dev libffi-dev boost-dev \
    sqlite sqlite-dev imagemagick sox ffmpeg \
    bzip2-dev xz-dev zlib-dev \
    py3-numpy py3-scipy shadow && \
    rm -rf /var/cache/apk/*

RUN apk add --no-cache \
      build-base \
      python3-dev \
      py3-pip \
      py3-setuptools \
      py3-wheel \
      openblas-dev \
      gfortran \
      meson \
      ninja \
      musl-dev

RUN apk add --no-cache \
    build-base gfortran lapack-dev openblas-dev \
    cython py3-numpy py3-scipy py3-pandas py3-opencv \
    meson ninja pkgconf

# Create sandbox user
RUN adduser -D -s /bin/ash sandbox && \
    echo "sandbox:sandbox" | chpasswd && \
    adduser sandbox wheel

# Create workspace directory
RUN mkdir -p /workspace /training_data && \
    chown -R sandbox:sandbox /workspace /training_data

RUN curl https://pyenv.run | bash


ENV HOME /root
# Set up environment variables for pyenv
ENV PYENV_ROOT="/root/.pyenv"
ENV PATH="$PYENV_ROOT/shims:$PYENV_ROOT/bin:$PATH"

RUN /bin/bash -c "eval \"$(pyenv init --path)\" && \
    (pyenv install 3.10.0 && pyenv global 3.10.0 && pyenv rehash && python --version) || \
    echo 'pyenv install skipped, using system python'"

# Install Python packages for AI operations
# Install build deps
RUN apk add --no-cache \
    build-base gfortran lapack-dev openblas-dev \
    cython py3-numpy meson ninja pkgconf

RUN python3 -m venv /home/sandbox/.venv && \
    chown -R sandbox:sandbox /home/sandbox/.venv && \
    /home/sandbox/.venv/bin/pip install --upgrade pip && \
    /home/sandbox/.venv/bin/pip install --no-cache-dir \
        "scikit-learn<1.6" \
        requests aiohttp websockets \
        psutil docker \
        numpy pandas scipy pillow pytesseract SpeechRecognition \
        pyttsx3 beautifulsoup4 psutil

ENV PATH="/home/sandbox/.venv/bin:$PATH"


# Install Node.js packages for web automation
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_SKIP_DOWNLOAD=true
RUN npm install -g --unsafe-perm \
    puppeteer \
    cheerio \
    axios \
    ws

# Set up supervisor for process management
RUN mkdir -p /etc/supervisord.d /var/log/supervisor && \
    chown -R sandbox:sandbox /var/log/supervisor
COPY docker/sandbox/supervisord.conf /etc/supervisord.d/supervisord.conf

# Copy training scripts
COPY docker/training/train_linux_operations.py /usr/local/bin/
RUN chmod +x /usr/local/bin/train_linux_operations.py

# Set working directory
WORKDIR /workspace

# Switch to sandbox user
USER sandbox

# Environment variables
ENV HOME=/home/sandbox
ENV PATH="/home/sandbox/.venv/bin:/home/sandbox/.local/bin:${PATH}"
ENV SANDBOX_TYPE=alpine

# Default command
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisord.d/supervisord.conf"]
