FROM opensuse/leap:15.5

WORKDIR /root

# Install essential packages
RUN zypper refresh && zypper update -y && zypper install -y \
    curl wget gpg2 ca-certificates patch gzip \
    make gcc gcc-c++ file procps net-tools gawk tar \
    python3 python3-pip python3-devel \
    libffi-devel sqlite3 supervisor \
    ImageMagick sox \
    cmake git \
    libopenssl-devel zlib-devel libbz2-devel readline-devel \
    sqlite3-devel ncurses-devel xz-devel tk-devel \
    libxml2-devel \
    && zypper clean --all
RUN zypper refresh && zypper install -y python312 python312-pip python312-devel
# Install Node.js (official binary tarball for broad compatibility)
ENV NODE_VERSION=20.14.0
RUN curl -fsSL https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.gz | \
    gunzip | tar -x -C /usr/local --strip-components=1 && \
    ln -sf /usr/local/bin/node /usr/bin/node && \
    ln -sf /usr/local/bin/npm /usr/bin/npm

# Create sandbox user
RUN groupadd -f sandbox && \
    useradd -m -g sandbox -s /bin/bash sandbox && \
    echo "sandbox:sandbox" | chpasswd

# Create workspace directory
RUN mkdir -p /workspace /training_data && \
    chown -R sandbox:sandbox /workspace /training_data

# Install pyenv
RUN curl https://pyenv.run | bash

ENV HOME /root
# Set up environment variables for pyenv
ENV PYENV_ROOT="/root/.pyenv"
ENV PATH="$PYENV_ROOT/bin:$PATH"

RUN eval "$(pyenv init --path)" && \
    pyenv install 3.12.0 && \
    pyenv global 3.12.0 && \
    pyenv rehash && \
    python --version

# Install Python packages for AI operations
# Install Python packages for AI operations using Python 3.11
RUN python3.11 -m pip install --upgrade pip && \
    python3.11 -m pip install \
    requests aiohttp websockets \
    psutil docker \
    opencv-python-headless \
    numpy pandas scipy \
    scikit-learn \
    pillow \
    pytesseract \
    SpeechRecognition \
    pyttsx3 \
    beautifulsoup4 \
    selenium \
    playwright
    
# Install Node.js packages for web automation
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_SKIP_DOWNLOAD=true
RUN npm install -g --unsafe-perm \
    puppeteer \
    cheerio \
    axios \
    ws

# Set up supervisor for process management
RUN mkdir -p /etc/supervisor/conf.d
COPY docker/sandbox/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Copy training scripts
COPY docker/training/train_linux_operations.py /usr/local/bin/
RUN chmod +x /usr/local/bin/train_linux_operations.py

# Set working directory
WORKDIR /workspace

# Switch to sandbox user
USER sandbox

# Environment variables
ENV HOME=/home/sandbox
ENV PATH="/home/sandbox/.local/bin:${PATH}"
ENV SANDBOX_TYPE=opensuse

# Default command
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]