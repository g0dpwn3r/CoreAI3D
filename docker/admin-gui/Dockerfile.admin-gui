FROM lscr.io/linuxserver/webtop:ubuntu-xfce

# Install Python 3.10 from deadsnakes PPA alongside system Python
# DO NOT change the default python3 - this breaks Selkies streaming
RUN apt-get update && \
    apt-get install -y software-properties-common && \
    add-apt-repository -y ppa:deadsnakes/ppa && \
    apt-get update && \
    apt-get install -y \
        python3.10 \
        python3.10-venv \
        python3.10-dev \
        python3.10-distutils \
        curl && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    # Install pip for Python 3.10 specifically (don't override system pip)
    curl -sS https://bootstrap.pypa.io/get-pip.py | python3.10 && \
    # Create symlinks for Python 3.10 (but don't override python3)
    ln -sf /usr/bin/python3.10 /usr/local/bin/python3.10 && \
    ln -sf /usr/local/lib/python3.10/dist-packages/pip /usr/local/bin/pip3.10 || true

# Install Qt6/XCB dependencies for PyQt6 GUI applications
# These are needed to run Qt-based applications in the webtop environment
# Packages use Ubuntu 24.04 (noble) names - old mesa packages were renamed
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libxcb-cursor0 \
        libxcb-xinerama0 \
        libxkbcommon-x11-0 \
        libxcb1 \
        libx11-xcb1 \
        libxcb-icccm4 \
        libxcb-image0 \
        libxcb-keysyms1 \
        libxcb-randr0 \
        libxcb-render-util0 \
        libxcb-shape0 \
        libxrender1 \
        libxcb-sync1 \
        libxcb-xfixes0 \
        libxcb-xkb1 \
        libxkbcommon0 \
        libgl1 \
        libegl1 \
        libglib2.0-0t64 \
        libfontconfig1 \
        libdbus-1-3 \
        libfreetype6 \
        libxext6 \
        libsm6 \
        libice6 \
        libnss3 \
        libxcomposite1 \
        libxdamage1 \
        libxi6 \
        libxtst6 \
        libxcursor1 \
        libxrandr2 \
        libopengl0 \
        && apt-get clean \
        && rm -rf /var/lib/apt/lists/*

# Python 3.10 is now available as:
# - python3.10
# - pip3.10
# 
# DO NOT run: update-alternatives --set python3 /usr/bin/python3.10
# This would break Selkies streaming in the webtop base image