FROM lscr.io/linuxserver/webtop:ubuntu-xfce

# Install Python 3.10 from deadsnakes PPA
RUN apt-get update && \
    apt-get install -y software-properties-common && \
    add-apt-repository -y ppa:deadsnakes/ppa && \
    apt-get update && \
    apt-get install -y \
        python3.10 \
        python3.10-venv \
        python3.10-dev && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Set up Python 3.10 as an alternative
# Registreer Python 3.10 en stel deze direct in als de standaard python3
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.10 100 \
    && update-alternatives --set python3 /usr/bin/python3.10